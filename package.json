{
  "name": "fajar-toyota-profile",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro check && astro build",
    "build:production": "SITE_STAGE=production npm run build",
