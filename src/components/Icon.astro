  car: 'M5 17H3v-6l2-6h14l2 6v6h-2M5 17h14M5 17v3M19 17v3M3 11h18M6 14h1M17 14h1',
  leaf: 'M20 4c1 8-2 15-8 15a7 7 0 0 1-7-7C5 6 12 3 20 4ZM4 21l11-11',
