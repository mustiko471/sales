---
import { faqs } from '../data/faqs';
import { site } from '../data/site';
import Icon from './Icon.astro';
---

<section class="section faq-section">
  <div class="container faq-grid">
    <div>
      <p class="eyebrow">
        <span class="red-line"></span> SEBELUM MEMULAI
      </p>
      <h2>
        Mungkin ini
        <br />
        yang Anda
        <br />
        <span class="muted-heading">tanyakan.</span>
      </h2>
      <p>Belum menemukan jawabannya?</p>
      <a href="/kontak/" class="text-link">
        Tanyakan ke {site.name} <Icon name="arrow" size={18} />
      </a>
    </div>
    <div class="faq-list">
      {faqs.map((faq, index) => (
        <details>
          <summary>
            <span class="faq-number">0{index + 1}</span>
            <span>{faq.question}</span>
            <Icon name="plus" size={19} />
          </summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
